<?xml version="1.0"?>
<sdf version="1.10">
  <world name="hexapod_test">
    <!-- Gazebo Sensor System Pluins for IMU and LIDAR-->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    
    <!-- ========================================================= -->
    <!-- WORLD PHYSICS                                             -->
    <!-- ========================================================= -->

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ========================================================= -->
    <!-- GROUND                                                    -->
    <!-- Gazebo-style dark grey                                    -->
    <!-- ========================================================= -->

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="floor_link">

        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 8 0.1</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="floor_visual">
         <geometry>
          <box>
           <size>10 8 0.1</size>
          </box>
         </geometry>

  <material>
    <ambient>0.9 0.9 0.9 1</ambient>
    <diffuse>1.0 1.0 1.0 1</diffuse>
  </material>
</visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- NORTH WALL                                                -->
    <!-- ========================================================= -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 4 1 0 0 0</pose>

      <link name="north_wall_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.60 0.60 0.60 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- SOUTH WALL                                                -->
    <!-- ========================================================= -->

    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 1 0 0 0</pose>

      <link name="south_wall_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.60 0.60 0.60 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- EAST WALL                                                 -->
    <!-- ========================================================= -->

    <model name="east_wall">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>

      <link name="east_wall_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.60 0.60 0.60 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- WEST WALL                                                 -->
    <!-- ========================================================= -->

    <model name="west_wall">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>

      <link name="west_wall_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.60 0.60 0.60 1</ambient>
            <diffuse>0.70 0.70 0.70 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PILLAR 1                                                  -->
    <!-- ========================================================= -->

    <model name="pillar1">
      <static>true</static>
      <pose>-2.5 1.8 1 0 0 0</pose>

      <link name="pillar1_link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PILLAR 2                                                  -->
    <!-- ========================================================= -->

    <model name="pillar2">
      <static>true</static>
      <pose>0 1.8 1 0 0 0</pose>

      <link name="pillar2_link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PILLAR 3                                                  -->
    <!-- ========================================================= -->

    <model name="pillar3">
      <static>true</static>
      <pose>2.5 1.8 1 0 0 0</pose>

      <link name="pillar3_link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PILLAR 4                                                  -->
    <!-- ========================================================= -->

    <model name="pillar4">
      <static>true</static>
      <pose>-1.25 -1.5 1 0 0 0</pose>

      <link name="pillar4_link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ========================================================= -->
    <!-- PILLAR 5                                                  -->
    <!-- ========================================================= -->

    <model name="pillar5">
      <static>true</static>
      <pose>1.25 -1.5 1 0 0 0</pose>

      <link name="pillar5_link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>2</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.20 0.20 0.20 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>